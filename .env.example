# Sync
REPOS_DIR=./repos
DATABASE_URL=postgresql://repo_sync:repo_sync@localhost:5432/repo_sync

# API
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_API_KEY=your-secret-api-key
